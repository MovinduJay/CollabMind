# Optional Docker environment overrides.
# docker-compose.yml already has safe local defaults, so this file is not required.

POSTGRES_USER=collabmind
POSTGRES_PASSWORD=collabmind_dev_password

APP_JWT_SECRET=collabmind-development-secret-key-change-this-later-123456789

# Optional if switching ai-orchestrator from mock to Gemini later.
GEMINI_API_KEY=

# OpenAI is the default Docker AI provider.
COLLABMIND_AI_PROVIDER=openai
COLLABMIND_AI_FALLBACK_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Distributed runtime
REDIS_HOST=redis
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
ROOM_TTL=PT24H

# Optional. Public GitHub repos work without this.
# Use this for private repos or higher GitHub API rate limits.
GITHUB_TOKEN=
