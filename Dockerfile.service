ARG JAVA_VERSION=23

FROM maven:3.9-eclipse-temurin-${JAVA_VERSION} AS build

ARG SERVICE_PATH

WORKDIR /workspace

COPY . .

WORKDIR /workspace/${SERVICE_PATH}

RUN mvn -B clean package -Dmaven.test.skip=true

RUN JAR_FILE=$(find target -maxdepth 1 -type f -name "*.jar" ! -name "*.original" | head -n 1) && \
    cp "$JAR_FILE" /workspace/app.jar

FROM eclipse-temurin:${JAVA_VERSION}-jre-alpine

WORKDIR /app

COPY --from=build /workspace/app.jar app.jar

RUN apk upgrade --no-cache && \
    addgroup -g 10001 -S collabmind && \
    adduser -u 10001 -S -D -H -h /app -G collabmind collabmind && \
    chown 10001:10001 /app/app.jar

EXPOSE 8080

USER 10001:10001

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
