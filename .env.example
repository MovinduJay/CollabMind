# CollabMind local development environment example
# Do NOT put real secrets in this file.

# =========================
# Chat Core Database
# =========================
CHAT_DB_USERNAME=postgres
CHAT_DB_PASSWORD=change-me

# =========================
# Identity Service Database
# =========================
IDENTITY_DB_USERNAME=postgres
IDENTITY_DB_PASSWORD=change-me

# =========================
# AI Orchestrator Database
# =========================
AI_DB_USERNAME=postgres
AI_DB_PASSWORD=change-me

# =========================
# JWT
# =========================
APP_JWT_SECRET=collabmind-development-secret-key-change-this-later-123456789

# =========================
# Optional Gemini Provider
# =========================
GEMINI_API_KEY=

# =========================
# OpenAI Provider
# =========================
COLLABMIND_AI_PROVIDER=openai
COLLABMIND_AI_FALLBACK_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
